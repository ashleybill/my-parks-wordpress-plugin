{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "my-parks/park-maps",
	"version": "0.1.0",
	"title": "Park Maps",
	"category": "my-park-blocks",
	"icon": "location-alt",
	"description": "Display downloadable park maps (campground, trail, cabin, etc.).",
	"example": {},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Park Maps"
		},
		"showHeading": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		},
		"spacing": {
			"padding": true,
			"margin": true
		}
	},
	"usesContext": ["postId"],
	"textdomain": "my-parks",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
